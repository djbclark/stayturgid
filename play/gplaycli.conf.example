# Copy to ~/.config/gplaycli/gplaycli.conf (or pass -c to play/mac/gplaycli.sh)
# The default token dispenser (matlink.fr) is often down — use Google credentials.
#
# Use a Google App Password (2FA required): https://myaccount.google.com/apppasswords
# Do NOT commit real credentials.

[Credentials]
gmail_address=
gmail_password=
token=False

[Cache]
token=~/.cache/gplaycli/token

[Locale]
locale=en_US
timezone=UTC
