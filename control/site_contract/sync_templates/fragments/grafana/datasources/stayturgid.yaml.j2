#
# Grafana datasources for the Fleet Control Room. Ports come only from the
# site registry (StrictUndefined → exit 1 if missing). OpenObserve HTTP is
# listed as a Prometheus-compatible URL when credentials exist at runtime;
# default D5 ships VictoriaMetrics only (OO needs basic auth — no secrets here).

apiVersion: 1

datasources:
  - name: VictoriaMetrics
    type: prometheus
    uid: stayturgid-victoriametrics
    access: proxy
    url: http://127.0.0.1:{{ ports['victoriametrics'] }}
    isDefault: true
    editable: false
    jsonData:
      timeInterval: 15s
      httpMethod: POST

  - name: OpenObserve
    type: prometheus
    uid: stayturgid-openobserve
    access: proxy
    url: http://127.0.0.1:{{ ports['openobserve-http'] }}/api/default/prometheus
    isDefault: false
    editable: false
    basicAuth: true
    basicAuthUser: ${OPENOBSERVE_ROOT_EMAIL}
    secureJsonData:
      basicAuthPassword: ${OPENOBSERVE_ROOT_PASSWORD}
    jsonData:
      timeInterval: 15s
      httpMethod: POST
