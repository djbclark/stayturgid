#
# Product UI reverse-proxy routes. Own-mode base Caddyfile imports this file
# inside the site TLS block; inject mode copies it into the user's fragment_dir.
# Port numbers come only from the site registry (StrictUndefined → exit 1 if missing).
#
# Choice E (D7-ROUTES-E / §11 #9): path-prefix front door for O-V-G-O UIs +
# existing product routes. Specific matchers first; bare handle last
# (Caddy sorts unmatched handle last as catch-all).
#
# Path policy:
# - handle_path (strip prefix): apps that assume they own / (dashboard, opencode,
#   vlm, stats, olivetin, victoriametrics).
# - handle (preserve path): apps configured with a base/sub path (Grafana
#   serve_from_sub_path + root_url=/grafana/; OpenObserve ZO_BASE_URI=/oo).
#   Stripping would 301-loop Grafana (root_url → strip → root_url) and send
#   OO's /web/ redirect off the /oo/ prefix.

# Fleet dashboard (legacy Flask; retained until full D7)
handle_path /dashboard/* {
	reverse_proxy 127.0.0.1:{{ ports['fleet-dashboard'] }}
}

# OpenCode web UI
handle_path /opencode/* {
	reverse_proxy 127.0.0.1:{{ ports['opencode-web'] }}
}

# VLM server (llama.cpp UI-TARS)
handle_path /vlm/* {
	reverse_proxy 127.0.0.1:{{ ports['ui-tars-vlm'] }}
}

{% if 'ollama-llm-api' in ports %}
# Ollama local LLM API (site-owned, optional — omitted on sites without it)
handle_path /ollama/* {
	reverse_proxy 127.0.0.1:{{ ports['ollama-llm-api'] }}
}
{% endif %}

{% if 'litellm-proxy' in ports %}
# LiteLLM Proxy (site-owned, optional — omitted on sites without it)
handle_path /litellm/* {
	reverse_proxy 127.0.0.1:{{ ports['litellm-proxy'] }}
}
{% endif %}

# Fleet stats (same backend as dashboard)
handle_path /stats/* {
	reverse_proxy 127.0.0.1:{{ ports['fleet-dashboard'] }}
}

# ── O-V-G-O front-door routes (Choice E) ───────────────────────────────────
# Grafana: preserve /grafana/* (serve_from_sub_path=true)
handle /grafana/* {
	reverse_proxy 127.0.0.1:{{ ports['grafana'] }}
}

# OpenObserve: preserve /oo/* (ZO_BASE_URI=/oo; UI base href under prefix)
handle /oo/* {
	reverse_proxy 127.0.0.1:{{ ports['openobserve-http'] }}
}

# OliveTin / VictoriaMetrics: strip prefix (apps own /)
handle_path /olivetin/* {
	reverse_proxy 127.0.0.1:{{ ports['olivetin'] }}
}

handle_path /vm/* {
	reverse_proxy 127.0.0.1:{{ ports['victoriametrics'] }}
}

# Network landing page (service directory) — catch-all root
handle {
	reverse_proxy 127.0.0.1:{{ ports['landing'] }}
}
