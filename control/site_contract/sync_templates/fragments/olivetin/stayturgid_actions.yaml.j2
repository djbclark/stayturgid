actions:
  - id: stayturgid_fleet_health
    title: "Fleet health (just health)"
    icon: "&#129658;"
    timeout: 300
    shell: |
      export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
      cd {{ product_root }}
      just health
  - id: stayturgid_fleet_deploy_check
    title: "Deploy check — all hosts (dry-run)"
    icon: "&#128269;"
    timeout: 1800
    shell: |
      export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
      cd {{ product_root }}
      just deploy-check
  - id: stayturgid_fleet_deploy
    title: "Deploy fleet — all hosts"
    icon: "&#128640;"
    timeout: 3600
    shell: |
      export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
      cd {{ product_root }}
      just deploy
{% for host in inventory_hosts %}
  - id: stayturgid_deploy_{{ host.name | replace('-', '_') }}
    title: "Deploy {{ host.device_label | default(host.name) }} ({{ host.name }})"
    icon: "&#128640;"
    timeout: 1800
    shell: |
      export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
      cd {{ product_root }}
      just deploy {{ host.name }}
{% endfor %}
