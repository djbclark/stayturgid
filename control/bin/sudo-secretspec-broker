#!/bin/bash
# Root-owned, fail-closed SecretSpec broker.
# Caller-selected manifests, providers, profiles, binaries, and commands are
# intentionally impossible. All provider operations are value-free audited.
set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
umask 077

CONFIG=/usr/local/share/sudo-secretspec/sudo-secretspec.conf
[[ -f "$CONFIG" && ! -L "$CONFIG" ]] || { printf 'denied: managed configuration missing or symlinked\n' >&2; exit 2; }
[[ "$(stat -f '%Su:%Sg:%OLp' "$CONFIG")" == 'root:wheel:444' ]] || { printf 'denied: managed configuration metadata mismatch\n' >&2; exit 2; }
# shellcheck disable=SC1091
. "$CONFIG"
SECRETSPEC_BIN=$SUDO_SECRETSPEC_ENGINE
AUDIT_HELPER=$SUDO_SECRETSPEC_AUDIT
VAULT_DIR=$SUDO_SECRETSPEC_VAULT
VAULT_MANIFEST="$VAULT_DIR/secretspec.toml"
VAULT_ENV="$VAULT_DIR/.env"
SOURCE_EXAMPLE=$SUDO_SECRETSPEC_DECLARATIONS
SERVICE_USER=$SUDO_SECRETSPEC_SERVICE_USER
SERVICE_GROUP=$SUDO_SECRETSPEC_SERVICE_GROUP
CANONICAL_REALPATH=$SUDO_SECRETSPEC_VAULT_REALPATH

fail() {
  printf 'denied: %s\n' "$1" >&2
  exit 2
}
valid_name() { [[ "${1:-}" =~ ^[A-Z][A-Z0-9_]*$ ]] || fail 'secret name must be uppercase ASCII'; }
valid_text() {
  local label=$1 value=$2 limit=$3
  [[ -n "$value" && ${#value} -le "$limit" && "$value" != *$'\n'* && "$value" != *$'\r'* ]] || fail "invalid $label"
}
require_nonremovable_store() {
  [[ "$(realpath "$VAULT_DIR")" == "$CANONICAL_REALPATH" ]] || fail 'canonical directory resolves outside /private/var/db'
  local ancestor owner mode
  for ancestor in /private /private/var /private/var/db; do
    [[ -d "$ancestor" && ! -L "$ancestor" ]] || fail "unsafe canonical ancestor $ancestor"
    owner=$(stat -f '%Su' "$ancestor")
    mode=$(stat -f '%OLp' "$ancestor")
    [[ "$owner" == root && $((8#$mode & 8#022)) -eq 0 ]] || fail "operator-removable canonical ancestor $ancestor"
    [[ "$(/bin/ls -lde "$ancestor" | /usr/bin/wc -l | tr -d ' ')" == 1 ]] || fail "ACL-bearing canonical ancestor $ancestor"
  done
  [[ "$(/bin/ls -lde "$VAULT_DIR" | /usr/bin/wc -l | tr -d ' ')" == 1 ]] || fail 'ACL-bearing canonical directory'
}
require_boundary() {
  [[ -d "$VAULT_DIR" && ! -L "$VAULT_DIR" ]] || fail 'canonical directory missing or symlinked'
  require_nonremovable_store
  [[ "$(stat -f '%Su:%Sg:%OLp' "$VAULT_DIR")" == "$SERVICE_USER:$SERVICE_GROUP:700" ]] || fail 'canonical directory metadata mismatch'
  [[ -x "$SECRETSPEC_BIN" && ! -L "$SECRETSPEC_BIN" ]] || fail 'managed SecretSpec binary missing or symlinked'
  [[ -f "$AUDIT_HELPER" && ! -L "$AUDIT_HELPER" ]] || fail 'managed audit helper missing or symlinked'
  [[ "$(stat -f '%Su:%Sg:%OLp' "$SECRETSPEC_BIN")" == "root:wheel:755" ]] || fail 'managed SecretSpec binary metadata mismatch'
  [[ "$(stat -f '%Su:%Sg:%OLp' "$AUDIT_HELPER")" == "root:wheel:755" ]] || fail 'managed audit helper metadata mismatch'
}
require_store() {
  [[ -f "$VAULT_MANIFEST" && ! -L "$VAULT_MANIFEST" ]] || fail 'canonical manifest missing or symlinked'
  [[ -f "$VAULT_ENV" && ! -L "$VAULT_ENV" ]] || fail 'canonical dotenv missing or symlinked'
  [[ "$(stat -f '%Su:%Sg:%OLp' "$VAULT_MANIFEST")" == "$SERVICE_USER:staff:600" ]] || fail 'canonical manifest metadata mismatch'
  [[ "$(stat -f '%Su:%Sg:%OLp' "$VAULT_ENV")" == "$SERVICE_USER:staff:600" ]] || fail 'canonical dotenv metadata mismatch'
}
declared_name() {
  valid_name "$1"
  grep -Eq "^${1}[[:space:]]*=" "$VAULT_MANIFEST" || fail 'secret is not declared'
}
released_name() {
  valid_name "$1"
  grep -Eq "^${1}[[:space:]]*=" "$SOURCE_EXAMPLE" || fail 'secret is not in the released declaration example; merge and deploy the declaration first'
}
install_released_schema() {
  [[ -f "$SOURCE_EXAMPLE" && ! -L "$SOURCE_EXAMPLE" ]] || fail 'pinned declaration example missing or symlinked'
  [[ "$(stat -f '%Su:%Sg:%OLp' "$SOURCE_EXAMPLE")" == 'root:wheel:444' ]] || fail 'pinned declaration example metadata mismatch'
  local tmp="$VAULT_DIR/.secretspec.toml.new.$$"
  install -o "$SERVICE_USER" -g staff -m 0600 "$SOURCE_EXAMPLE" "$tmp"
  mv -f "$tmp" "$VAULT_MANIFEST"
}
mutation_backup() {
  manifest_backup="$VAULT_DIR/.secretspec.toml.rollback.$transaction"
  env_backup="$VAULT_DIR/.env.rollback.$transaction"
  [[ ! -e "$manifest_backup" && ! -L "$manifest_backup" && ! -e "$env_backup" && ! -L "$env_backup" ]] || fail 'rollback path collision'
  mutation_open=1
  install -o "$SERVICE_USER" -g staff -m 0600 "$VAULT_MANIFEST" "$manifest_backup" || {
    mutation_open=0
    return 1
  }
  install -o "$SERVICE_USER" -g staff -m 0600 "$VAULT_ENV" "$env_backup" || {
    rm -f "$manifest_backup"
    mutation_open=0
    return 1
  }
  mutation_open=1
}
mutation_restore() {
  [[ ${mutation_open:-0} -eq 1 ]] || return 0
  [[ -f "$manifest_backup" && ! -L "$manifest_backup" && -f "$env_backup" && ! -L "$env_backup" ]] || return 1
  mv -f "$manifest_backup" "$VAULT_MANIFEST"
  mv -f "$env_backup" "$VAULT_ENV"
  mutation_open=0
}
mutation_commit() {
  [[ ${mutation_open:-0} -eq 1 ]] || return 0
  rm -f "$manifest_backup" "$env_backup" || return 1
  mutation_open=0
}

operation=${1:-}
shift || true
client='' reason='' name='' command_basename=''
manifest_backup='' env_backup='' mutation_open=0
while (($#)); do
  case "$1" in
    --client)
      (($# >= 2)) || fail 'missing client'
      client=$2
      shift 2
      ;;
    --reason)
      (($# >= 2)) || fail 'missing reason'
      reason=$2
      shift 2
      ;;
    --name)
      (($# >= 2)) || fail 'missing name'
      name=$2
      shift 2
      ;;
    --command-basename)
      (($# >= 2)) || fail 'missing command basename'
      command_basename=$2
      shift 2
      ;;

    *) fail 'unknown broker argument' ;;
  esac
done

case "$operation" in
  source-add | source-set | source-delete | source-get | source-check | source-export)
    [[ "$(id -u)" -eq 0 ]] || fail 'lifecycle operation requires root broker execution'
    [[ "$client" =~ ^(hermes|claude|codex|opencode|cursor|agy|unknown)$ ]] || fail 'invalid client'
    valid_text reason "$reason" 512
    [[ -z "$command_basename" || "$command_basename" =~ ^[A-Za-z0-9_.+-]{1,128}$ ]] || fail 'invalid command basename'
    ;;
  automation-env | firerpa-mcp-token | audit-verify)
    [[ "$(id -un)" == "$SERVICE_USER" ]] || fail 'fixed consumer operation requires service identity'
    client="fixed-consumer"
    reason="approved fixed consumer"
    ;;
  source-template-check | source-publish)
    [[ "$(id -u)" -eq 0 ]] || fail 'health operation requires root broker execution'
    client=${client:-unknown}
    reason=${reason:-managed-health-check}
    ;;
  *) fail 'operation is not allowlisted' ;;
esac

require_boundary
service_uid=$(id -u "$SERVICE_USER")
transaction=$(/usr/bin/uuidgen | tr '[:upper:]' '[:lower:]')
reason_sha256=$(printf '%s' "$reason" | /usr/bin/shasum -a 256 | /usr/bin/cut -d' ' -f1)
audit_names=()
[[ -n "$name" ]] && audit_names=(--name "$name")
audit_event() {
  local phase=$1 rc=${2:-}
  local args=("$phase" --directory "$VAULT_DIR" --operation "$operation" --transaction "$transaction" --actor "${SUDO_USER:-$(id -un)}" --client "$client" --reason-sha256 "$reason_sha256" --expected-uid "$service_uid" "${audit_names[@]}")
  [[ -z "$command_basename" ]] || args+=(--command-basename "$command_basename")
  [[ "$phase" == attempt ]] || args+=(--result-code "$rc")
  if [[ "$(id -un)" == "$SERVICE_USER" ]]; then
    /usr/bin/python3 "$AUDIT_HELPER" "${args[@]}" >/dev/null
  else
    /usr/bin/sudo -u "$SERVICE_USER" /usr/bin/python3 "$AUDIT_HELPER" "${args[@]}" >/dev/null
  fi
}
run_spec() {
  if [[ "$(id -un)" == "$SERVICE_USER" ]]; then
    /usr/bin/env -i HOME="$VAULT_DIR" PATH=/usr/bin:/bin SECRETSPEC_PROVIDER=dotenv SECRETSPEC_FILE="$VAULT_MANIFEST" SECRETSPEC_REASON="$reason" "$SECRETSPEC_BIN" -f "$VAULT_MANIFEST" "$@"
  else
    /usr/bin/sudo -u "$SERVICE_USER" /usr/bin/env -i HOME="$VAULT_DIR" PATH=/usr/bin:/bin SECRETSPEC_PROVIDER=dotenv SECRETSPEC_FILE="$VAULT_MANIFEST" SECRETSPEC_REASON="$reason" "$SECRETSPEC_BIN" -f "$VAULT_MANIFEST" "$@"
  fi
}
finish() {
  local rc=$1
  if [[ ${unknown_outcome:-0} -eq 1 ]]; then audit_event unknown "$rc"; elif ((rc == 0)); then audit_event success 0; else audit_event failure "$rc"; fi
  audit_terminal=1
  return "$rc"
}

audit_event attempt
audit_open=1
audit_terminal=0
unknown_outcome=0
on_exit() {
  local rc=$?
  if [[ ${mutation_open:-0} -eq 1 ]]; then
    set +e
    mutation_restore || {
      rc=125
      unknown_outcome=1
    }
  fi
  if [[ ${audit_open:-0} -eq 1 && ${audit_terminal:-0} -eq 0 ]]; then
    set +e
    if [[ $unknown_outcome -eq 1 ]]; then audit_event unknown "$rc"; else audit_event failure "$rc"; fi
  fi
  exit "$rc"
}
trap on_exit EXIT
require_store
set +e
case "$operation" in
  audit-verify)
    /usr/bin/python3 "$AUDIT_HELPER" verify --directory "$VAULT_DIR" --expected-uid "$service_uid"
    rc=$?
    ;;
  automation-env | source-export)
    run_spec export --format json
    rc=$?
    ;;
  firerpa-mcp-token)
    run_spec get firerpa_mcp_token --reason "$reason"
    rc=$?
    ;;
  source-add)
    released_name "$name"
    grep -Eq "^${name}[[:space:]]*=" "$VAULT_MANIFEST" && fail 'secret is already declared'
    mutation_backup || fail 'could not create protected rollback copies'
    install_released_schema
    rc=$?
    if ((rc == 0)); then
      run_spec set "$name"
      rc=$?
    fi
    ;;
  source-set)
    declared_name "$name"
    mutation_backup || fail 'could not create protected rollback copies'
    run_spec set "$name"
    rc=$?
    ;;
  source-delete)
    declared_name "$name"
    grep -Eq "^${name}[[:space:]]*=" "$SOURCE_EXAMPLE" && fail 'declaration remains in released schema; remove it through a PR/release first'
    mutation_backup || fail 'could not create protected rollback copies'
    run_spec delete "$name"
    rc=$?
    if ((rc == 0)); then
      install_released_schema || rc=$?
    fi
    ;;
  source-get)
    declared_name "$name"
    run_spec get "$name"
    rc=$?
    ;;
  source-check)
    run_spec check --no-prompt
    rc=$?
    ;;
  source-template-check)
    [[ -f "$SOURCE_EXAMPLE" && ! -L "$SOURCE_EXAMPLE" ]] || fail 'tracked declaration example missing or symlinked'
    cmp -s "$VAULT_MANIFEST" "$SOURCE_EXAMPLE"
    rc=$?
    ((rc == 0)) && printf 'runtime manifest matches tracked declaration example\n'
    ;;
  source-publish) rc=0 ;;
  *) rc=2 ;;
esac
set -e
if ((rc != 0)) && [[ ${mutation_open:-0} -eq 1 ]]; then
  if ! mutation_restore; then
    unknown_outcome=1
    rc=125
  fi
fi
finish "$rc"
if ((rc == 0)) && [[ ${mutation_open:-0} -eq 1 ]]; then
  # Provider mutation and terminal audit are already durable. Pending cleanup
  # is separately visible to the watchdog and must not relabel the operation.
  mutation_commit || printf 'warning: protected rollback cleanup is pending\n' >&2
fi
trap - EXIT
exit "$rc"
