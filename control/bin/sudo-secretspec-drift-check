#!/usr/bin/env python3
"""Detect SecretSpec control-plane drift without reading secret contents.

This checker is deliberately non-repairing.  It inspects path types, symlink
targets, active text configuration, and ownership metadata only.  It never
opens a runtime manifest or dotenv file.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import stat
import subprocess
from dataclasses import dataclass
from pathlib import Path
from typing import Mapping, Sequence

RETIRED_SENTINEL = """# RETIRED SECRETSPEC PATH — NO SECRET VALUES
# Canonical runtime store: /var/db/stayturgid-secrets
# Use the root-owned sudo-secretspec-broker interface.
# If the managed broker is unavailable, stop and report the non-secret error.
# Touch ID/operator action is for broker installation or repair only; normal
# broker-mediated credential operations are autonomous.
# Do not create, copy, symlink, regenerate, relocate, or select an alternate
# manifest or provider.
"""
AUTHORIZATION_FAILURE = (
    "Canonical SecretSpec broker is unavailable. Stop and report the non-secret "
    "error. Do not create, copy, regenerate, relocate, or select an alternate "
    "manifest or provider. Touch ID/operator action is required only to repair "
    "or install the managed broker; normal broker-mediated credential operations "
    "are autonomous."
)


@dataclass(frozen=True)
class Layout:
    home: Path
    ops_root: Path
    retired_target: Path
    canonical_dir: Path = Path("/var/db/stayturgid-secrets")
    installed_wrapper: Path = Path("/usr/local/libexec/sudo-secretspec-broker")
    installed_client: Path = Path("/usr/local/bin/sudo-secretspec")
    verify_audit: bool = True
    verify_artifacts: bool = True
    verify_store: bool = True

    @property
    def retired_path(self) -> Path:
        return self.home / ".config" / "secretspec.toml"

    @property
    def checkout_manifest(self) -> Path:
        return self.ops_root / "site-private" / "secretspec.toml"

    @property
    def checkout_env(self) -> Path:
        return self.ops_root / "site-private" / ".env"

    @property
    def bashrc(self) -> Path:
        return self.home / ".bashrc"


def _finding(code: str, path: Path | None, detail: str) -> dict[str, str]:
    item = {"code": code, "detail": detail}
    if path is not None:
        item["path"] = str(path)
    return item


def _safe_text(path: Path) -> str:
    try:
        return path.read_text(errors="replace")
    except (FileNotFoundError, PermissionError, OSError):
        return ""


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(65536), b""):
            digest.update(block)
    return digest.hexdigest()


def _metadata(path: Path) -> tuple[str, str, int]:
    import grp
    import pwd

    info = path.stat(follow_symlinks=False)
    return pwd.getpwuid(info.st_uid).pw_name, grp.getgrgid(info.st_gid).gr_name, stat.S_IMODE(info.st_mode)


def _check_declaration_symlink(cfg: Layout, path: Path, findings: list[dict[str, str]]) -> None:
    expected = cfg.ops_root / "site-private" / "secretspec.toml.example"
    if not path.is_symlink() or path.resolve(strict=False) != expected.resolve(strict=False):
        findings.append(
            _finding(
                "DECLARATION_SYMLINK_DRIFT",
                path,
                "declaration symlink must target site-private/secretspec.toml.example",
            )
        )


def _store_is_removable(canonical: Path, *, required_realpath: Path, ancestors: Sequence[Path]) -> bool:
    if canonical.resolve(strict=False) != required_realpath:
        return True
    for ancestor in ancestors:
        ancestor_owner, _ancestor_group, ancestor_mode = _metadata(ancestor)
        if ancestor.is_symlink() or ancestor_owner != "root" or ancestor_mode & 0o022 or _has_extended_acl(ancestor):
            return True
    return False


def _has_extended_acl(path: Path) -> bool:
    result = subprocess.run(["/bin/ls", "-lde", str(path)], capture_output=True, text=True, check=False)
    return result.returncode != 0 or len(result.stdout.splitlines()) != 1


def _scan_active_text(cfg: Layout, *, include_live: bool = False) -> list[dict[str, str]]:
    findings: list[dict[str, str]] = []
    roots = [
        cfg.ops_root / "stayturgid/control",
        cfg.ops_root / "stayturgid/just",
        cfg.ops_root / "stayturgid" / "AGENTS.md",
        cfg.ops_root / "stayturgid" / ".github" / "workflows" / "test.yml",
        cfg.ops_root / "stayturgid" / "docs" / "operations" / "secretspec-secrets-management.md",
        cfg.ops_root / "stayturgid" / "docs" / "operations" / "secretspec-wrapper-lifecycle.md",
        cfg.ops_root / "site-djbclark/bin",
        cfg.ops_root / "site-djbclark/justfile",
        cfg.ops_root / "site-djbclark/docs/OPS-RELEASES.md",
        cfg.ops_root / "site-djbclark/docs/plans",
        cfg.ops_root / "site-djbclark/human",
        cfg.ops_root / "site-djbclark/inventory",
        cfg.ops_root / "site-djbclark/registry",
        cfg.ops_root / "site-djbclark/roles",
        cfg.ops_root / "site-djbclark/services",
        cfg.ops_root / "site-private/bin",
        cfg.ops_root / "site-private/home-agents.md",
        cfg.ops_root / "site-private/AGENTS.md",
        cfg.ops_root / "site-private/web",
    ]
    if include_live:
        roots.extend([cfg.home / ".hermes" / "scripts", cfg.home / ".hermes" / "skills"])
    allowed_suffixes = {".sh", ".bash", ".zsh", ".py", ".md", ".toml", ".yaml", ".yml", ".plist"}
    direct_file = re.compile(r"\bsecretspec\b[^\n]*(?:--file|-f)\s+")
    bare_cli = re.compile(r"(?m)^(?!\s*#).*\bsecretspec\s+(?:get|set|add|delete|check|export|run)\b")
    for root in roots:
        if not root.exists():
            continue
        candidates = [root] if root.is_file() else root.rglob("*")
        for path in candidates:
            if not path.is_file() or (
                path.suffix.lower() not in allowed_suffixes and not os.access(path, os.X_OK) and path.name != "justfile"
            ):
                continue
            # Historical tests/examples may mention hostile forms intentionally.
            if any(part in {".git", ".venv", "node_modules", "tests"} for part in path.parts):
                continue
            secret_skill = cfg.home / ".hermes" / "skills" / "ops" / "secrets-management"
            if path == secret_skill or secret_skill in path.parents:
                # The authoritative policy and its research archive name forbidden
                # paths to prohibit or document them; they are not executable clients.
                continue
            text = _safe_text(path)
            if "SUPERSEDED / HISTORICAL — DO NOT EXECUTE AS WRITTEN" in text:
                continue
            if direct_file.search(text):
                findings.append(
                    _finding("DIRECT_FILE_BYPASS", path, "active code selects a caller-controlled SecretSpec manifest")
                )
            for line in text.splitlines():
                if bare_cli.search(line) and "sudo-secretspec" not in line:
                    findings.append(
                        _finding("DIRECT_CLI_BYPASS", path, "active code invokes SecretSpec outside the managed client")
                    )
                    break
            if path.name != "sudo-secretspec-drift-check" and re.search(
                r"(?m)^(?!\s*#).*\bSUDO_SECRETSPEC_DIRECT\b", text
            ):
                findings.append(
                    _finding("DIRECT_MODE_REFERENCE", path, "active code references the retired direct-mode bypass")
                )
            if path.name == "AGENTS.md" and re.search(r"Spec at `secretspec\.toml`|managed via `secretspec`", text):
                findings.append(
                    _finding(
                        "PROJECT_MANIFEST_INSTRUCTION",
                        path,
                        "active agent policy treats a project manifest or bare CLI as authoritative",
                    )
                )
    return findings


def inspect(cfg: Layout, *, environ: Mapping[str, str] | None = None, runtime: bool = True) -> dict:
    env = os.environ if environ is None else environ
    findings: list[dict[str, str]] = []

    retired = cfg.retired_path
    if runtime and not retired.is_symlink():
        findings.append(
            _finding(
                "GLOBAL_MANIFEST_NOT_SENTINEL", retired, "retired global path must be the managed sentinel symlink"
            )
        )
    elif runtime:
        try:
            target = retired.resolve(strict=False)
        except OSError:
            target = Path("/")
        if target != cfg.retired_target.resolve(strict=False):
            findings.append(
                _finding(
                    "GLOBAL_SENTINEL_TARGET_MISMATCH", retired, "retired global path targets an unexpected location"
                )
            )
        elif _safe_text(cfg.retired_target) != RETIRED_SENTINEL:
            findings.append(
                _finding("GLOBAL_SENTINEL_CONTENT_MISMATCH", cfg.retired_target, "managed sentinel text has drifted")
            )

    if cfg.checkout_manifest.exists() or cfg.checkout_manifest.is_symlink():
        findings.append(
            _finding(
                "CHECKOUT_MANIFEST_PRESENT",
                cfg.checkout_manifest,
                "runtime manifest must not exist in the deploy checkout",
            )
        )
    if cfg.checkout_env.exists() or cfg.checkout_env.is_symlink():
        findings.append(
            _finding("CHECKOUT_ENV_PRESENT", cfg.checkout_env, "runtime dotenv must not exist in the deploy checkout")
        )
    for declaration_link in (
        cfg.ops_root / "stayturgid" / "secretspec.toml",
        cfg.ops_root / "site-djbclark" / "secretspec.toml",
    ):
        _check_declaration_symlink(cfg, declaration_link, findings)

    if runtime and env.get("SECRETSPEC_FILE"):
        findings.append(_finding("SECRETSPEC_FILE_SET", None, "global SECRETSPEC_FILE bypasses the managed wrapper"))

    shell_text = _safe_text(cfg.bashrc) if runtime else ""
    if runtime and re.search(r"(?:export\s+)?SECRETSPEC_FILE\s*=", shell_text):
        findings.append(
            _finding("SHELL_OVERRIDE_PRESENT", cfg.bashrc, "shell startup exports a SecretSpec manifest override")
        )
    if runtime and env.get("SUDO_SECRETSPEC_DIRECT"):
        findings.append(_finding("DIRECT_MODE_SET", None, "retired direct-mode override is set"))
    if runtime and "SUDO_SECRETSPEC_DIRECT" in shell_text:
        findings.append(
            _finding("SHELL_DIRECT_MODE_PRESENT", cfg.bashrc, "shell startup contains the retired direct-mode override")
        )
    if runtime and re.search(r"(?m)^secretspec\(\)\s*\{", shell_text):
        findings.append(
            _finding("SHELL_LEGACY_CLIENT_PRESENT", cfg.bashrc, "shell startup shadows the root-owned managed client")
        )

    source_root = cfg.ops_root / "stayturgid"
    source_wrapper = source_root / "control/bin/sudo-secretspec-broker"
    source_client = source_root / "control/bin/sudo-secretspec"
    runtime_executables = (
        (
            ("WRAPPER_DRIFT", cfg.installed_wrapper, source_wrapper, 0o755),
            ("CLIENT_DRIFT", cfg.installed_client, source_client, 0o755),
            (
                "AUDIT_HELPER_DRIFT",
                Path("/usr/local/libexec/sudo-secretspec-audit"),
                source_root / "control/lib/secretspec_audit.py",
                0o755,
            ),
            (
                "CHECKER_DRIFT",
                Path("/usr/local/bin/sudo-secretspec-drift-check"),
                source_root / "control/bin/sudo-secretspec-drift-check",
                0o755,
            ),
            ("SENTINEL_DRIFT", cfg.retired_target, source_root / "control/config/sudo-secretspec-retired.toml", 0o444),
            (
                "SCHEMA_DRIFT",
                Path("/usr/local/share/sudo-secretspec/secretspec.toml.example"),
                cfg.ops_root / "site-private/secretspec.toml.example",
                0o444,
            ),
            (
                "SUDOERS_DRIFT",
                Path("/etc/sudoers.d/sudo-secretspec"),
                source_root / "control/config/sudoers.d/secretspec",
                0o440,
            ),
            (
                "MANAGED_BINARY_METADATA",
                Path("/usr/local/libexec/sudo-secretspec-engine"),
                Path("/opt/homebrew/bin/secretspec"),
                0o755,
            ),
        )
        if runtime and cfg.verify_artifacts
        else ()
    )
    for code, installed, source, mode in runtime_executables:
        try:
            owner, group, actual_mode = _metadata(installed)
            if (
                installed.is_symlink()
                or not installed.is_file()
                or _sha256(installed) != _sha256(source)
                or (owner, group, actual_mode) != ("root", "wheel", mode)
            ):
                findings.append(_finding(code, installed, "installed managed executable differs from released source"))
            ancestors = (
                (Path("/etc"), Path("/etc/sudoers.d"))
                if installed == Path("/etc/sudoers.d/sudo-secretspec")
                else (Path("/usr"), Path("/usr/local"), installed.parent)
            )
            if any(
                ancestor.is_symlink()
                or _metadata(ancestor)[0] != "root"
                or _metadata(ancestor)[2] & 0o022
                or _has_extended_acl(ancestor)
                for ancestor in ancestors
            ):
                findings.append(
                    _finding(
                        "REMOVABLE_INSTALLED_BOUNDARY",
                        installed,
                        "installed boundary can be replaced through its parent chain",
                    )
                )
        except (FileNotFoundError, PermissionError, OSError):
            findings.append(_finding(code, installed, "installed or released managed executable is unavailable"))

    if runtime and cfg.verify_store:
        try:
            owner, group, mode = _metadata(cfg.canonical_dir)
            removable = _store_is_removable(
                cfg.canonical_dir,
                required_realpath=Path("/private/var/db/stayturgid-secrets"),
                ancestors=(Path("/private"), Path("/private/var"), Path("/private/var/db")),
            )
            if removable:
                findings.append(
                    _finding(
                        "REMOVABLE_BACKING_STORE",
                        cfg.canonical_dir,
                        "operator can replace/remove backing state through its parent chain",
                    )
                )
            if cfg.canonical_dir.is_symlink() or (owner, group, mode) != ("_secretspec", "staff", 0o700):
                findings.append(
                    _finding(
                        "CANONICAL_DIR_METADATA", cfg.canonical_dir, "canonical directory must be non-symlink mode 0700"
                    )
                )
            ledger = cfg.canonical_dir / "broker-audit.sqlite3"
            if ledger.exists():
                ledger_owner, ledger_group, ledger_mode = _metadata(ledger)
                if (
                    ledger.is_symlink()
                    or not ledger.is_file()
                    or (ledger_owner, ledger_group, ledger_mode) != ("_secretspec", "staff", 0o600)
                ):
                    findings.append(
                        _finding(
                            "AUDIT_LEDGER_METADATA",
                            ledger,
                            "audit ledger must be _secretspec:staff, non-symlink mode 0600",
                        )
                    )
            for rollback in cfg.canonical_dir.glob(".*.rollback.*"):
                findings.append(
                    _finding(
                        "PENDING_SECRET_ROLLBACK",
                        rollback,
                        "protected mutation rollback remains; inspect transaction outcome before retrying",
                    )
                )
        except (FileNotFoundError, PermissionError, OSError):
            findings.append(
                _finding("CANONICAL_DIR_UNAVAILABLE", cfg.canonical_dir, "canonical directory metadata is unavailable")
            )
        if cfg.verify_audit:
            audit_check = subprocess.run(
                ["sudo", "-n", "-u", "_secretspec", str(cfg.installed_wrapper), "audit-verify"],
                capture_output=True,
                text=True,
                check=False,
            )
            if audit_check.returncode:
                findings.append(
                    _finding(
                        "AUDIT_LEDGER_INVALID",
                        cfg.canonical_dir / "broker-audit.sqlite3",
                        "protected audit verification failed",
                    )
                )

    findings.extend(_scan_active_text(cfg, include_live=runtime))
    return {"ok": not findings, "findings": findings, "authorization_failure": AUTHORIZATION_FAILURE}


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--home", type=Path, default=Path.home())
    p.add_argument("--ops-root", type=Path, default=Path.home() / "ops")
    p.add_argument(
        "--retired-target",
        type=Path,
        default=Path("/usr/local/share/sudo-secretspec/sudo-secretspec-retired.toml"),
    )
    p.add_argument("--json", action="store_true")
    p.add_argument("--canonical-dir", type=Path, default=Path("/var/db/stayturgid-secrets"))
    p.add_argument(
        "--installed-wrapper", type=Path, default=Path("/usr/local/libexec/sudo-secretspec-broker")
    )
    p.add_argument("--installed-client", type=Path, default=Path("/usr/local/bin/sudo-secretspec"))
    p.add_argument("--static-only", action="store_true", help="skip host runtime checks for CI/pre-commit")
    return p


def main(argv: Sequence[str] | None = None) -> int:
    args = parser().parse_args(argv)
    report = inspect(
        Layout(
            args.home,
            args.ops_root,
            args.retired_target,
            args.canonical_dir,
            args.installed_wrapper,
            args.installed_client,
        ),
        runtime=not args.static_only,
    )
    if args.json:
        print(json.dumps(report, sort_keys=True))
    elif report["ok"]:
        print("SecretSpec drift check: OK")
    else:
        print("SecretSpec drift check: FAILED")
        for finding in report["findings"]:
            where = f" ({finding['path']})" if "path" in finding else ""
            print(f"- {finding['code']}{where}: {finding['detail']}")
        print(AUTHORIZATION_FAILURE)
    return 0 if report["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
