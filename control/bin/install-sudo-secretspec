#!/bin/bash
# Transactionally install the managed SecretSpec boundary without reading values.
set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
umask 077

[[ "$(id -u)" -eq 0 ]] || {
  echo 'must run as root' >&2
  exit 2
}
OPS_ROOT=${OPS_ROOT:-/Users/djbclark/ops}
SRC="$OPS_ROOT/stayturgid"
LIBEXEC=${SECRETSPEC_INSTALL_LIBEXEC:-/usr/local/libexec}
BINDIR=${SECRETSPEC_INSTALL_BINDIR:-/usr/local/bin}
SHARE=${SECRETSPEC_INSTALL_SHARE:-/usr/local/share/sudo-secretspec}
SUDOERS=${SECRETSPEC_INSTALL_SUDOERS:-/etc/sudoers.d/sudo-secretspec}
VAULT=${SECRETSPEC_INSTALL_VAULT:-/var/db/stayturgid-secrets}
SECRETSPEC_SOURCE=${SECRETSPEC_INSTALL_BINARY:-/opt/homebrew/bin/secretspec}
VISUDO=${SECRETSPEC_INSTALL_VISUDO:-/usr/sbin/visudo}
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
ROLLBACK="$LIBEXEC/sudo-secretspec-rollback-$STAMP"
STAGE="$ROLLBACK/stage"

fail() {
  printf 'install denied: %s\n' "$1" >&2
  exit 2
}
regular_source() { [[ -f "$1" && ! -L "$1" ]] || fail "unsafe source $1"; }
metadata() { stat -f '%d:%i:%z:%m:%c:%Su:%Sg:%OLp' "$1"; }
sha() { shasum -a 256 "$1" | cut -d' ' -f1; }

# One indexed manifest prevents source/destination/mode ordering drift.
SOURCES=(
  "$SRC/control/bin/sudo-secretspec-broker"
  "$SRC/control/lib/secretspec_audit.py"
  "$SECRETSPEC_SOURCE"
  "$SRC/control/bin/sudo-secretspec"
  "$SRC/control/bin/sudo-secretspec-drift-check"
  "$SRC/control/config/sudo-secretspec-retired.toml"
  "$OPS_ROOT/site-private/secretspec.toml.example"
  "$SRC/control/config/sudoers.d/secretspec"
)
DESTINATIONS=(
  "$LIBEXEC/sudo-secretspec-broker"
  "$LIBEXEC/sudo-secretspec-audit"
  "$LIBEXEC/sudo-secretspec-engine"
  "$BINDIR/sudo-secretspec"
  "$BINDIR/sudo-secretspec-drift-check"
  "$SHARE/sudo-secretspec-retired.toml"
  "$SHARE/secretspec.toml.example"
  "$SUDOERS"
)
MODES=(0755 0755 0755 0755 0755 0444 0444 0440)
[[ ${#SOURCES[@]} -eq ${#DESTINATIONS[@]} && ${#SOURCES[@]} -eq ${#MODES[@]} ]] || fail 'installer manifest length mismatch'
for path in "${SOURCES[@]}"; do regular_source "$path"; done
[[ -d "$VAULT" && ! -L "$VAULT" ]] || fail 'canonical vault directory missing or symlinked'
[[ "$(realpath "$VAULT")" == '/private/var/db/stayturgid-secrets' ]] || fail 'canonical vault resolves outside /private/var/db'
for ancestor in /private /private/var /private/var/db; do
  [[ -d "$ancestor" && ! -L "$ancestor" && "$(stat -f '%Su' "$ancestor")" == root ]] || fail "unsafe canonical ancestor $ancestor"
  mode=$(stat -f '%OLp' "$ancestor")
  [[ $((8#$mode & 8#022)) -eq 0 ]] || fail "operator-removable canonical ancestor $ancestor"
  [[ "$(/bin/ls -lde "$ancestor" | /usr/bin/wc -l | tr -d ' ')" == 1 ]] || fail "ACL-bearing canonical ancestor $ancestor"
done
[[ "$(/bin/ls -lde "$VAULT" | /usr/bin/wc -l | tr -d ' ')" == 1 ]] || fail 'ACL-bearing canonical vault'
[[ "$(stat -f '%Su:%Sg:%OLp' "$VAULT")" == '_secretspec:staff:700' ]] || fail 'canonical vault metadata mismatch'

mkdir -p "$LIBEXEC" "$BINDIR" "$SHARE"
chmod 0755 "$LIBEXEC" "$BINDIR" "$SHARE"
chown root:wheel "$LIBEXEC" "$BINDIR" "$SHARE"
for protected_dir in /usr /usr/local "$LIBEXEC" "$BINDIR" "$SHARE"; do
  [[ -d "$protected_dir" && ! -L "$protected_dir" && "$(stat -f '%Su:%Sg:%OLp' "$protected_dir")" == 'root:wheel:755' ]] || fail "unsafe installed-artifact ancestor $protected_dir"
  [[ "$(/bin/ls -lde "$protected_dir" | /usr/bin/wc -l | tr -d ' ')" == 1 ]] || fail "ACL-bearing installed-artifact ancestor $protected_dir"
done
mkdir -m 0700 "$ROLLBACK"
chown root:wheel "$ROLLBACK"
mkdir -m 0700 "$STAGE"
chown root:wheel "$STAGE"

# Copy writable checkout/Homebrew sources once into protected root-owned staging.
for i in "${!SOURCES[@]}"; do
  source_path=${SOURCES[$i]}
  before=$(metadata "$source_path")
  stage_path="$STAGE/$i"
  install -o root -g wheel -m "${MODES[$i]}" "$source_path" "$stage_path"
  after=$(metadata "$source_path")
  [[ "$before" == "$after" ]] || fail "source changed during staging: $source_path"
  [[ "$(sha "$source_path")" == "$(sha "$stage_path")" ]] || fail "source changed while copied: $source_path"
  printf '%s  %s\n' "$(sha "$stage_path")" "$i" >>"$ROLLBACK/staged.sha256"
done
"$VISUDO" -c -f "$STAGE/7" >/dev/null

# Snapshot current destinations before any replacement.
for i in "${!DESTINATIONS[@]}"; do
  path=${DESTINATIONS[$i]}
  if [[ -e "$path" || -L "$path" ]]; then
    [[ -f "$path" && ! -L "$path" ]] || fail "unsafe existing destination $path"
    install -o root -g wheel -m "$(stat -f '%OLp' "$path")" "$path" "$ROLLBACK/$i"
    printf 'present:%s\n' "$(sha "$ROLLBACK/$i")" >"$ROLLBACK/$i.state"
  else
    printf 'absent\n' >"$ROLLBACK/$i.state"
  fi
done

commit_started=0
rollback_verified=1
rollback() {
  original_rc=$?
  trap - EXIT
  if [[ $commit_started -eq 1 ]]; then
    set +e
    for ((i = ${#DESTINATIONS[@]} - 1; i >= 0; i--)); do
      destination=${DESTINATIONS[$i]}
      state=$(cat "$ROLLBACK/$i.state") || {
        rollback_verified=0
        continue
      }
      case "$state" in
        present:*)
          mode=$(stat -f '%OLp' "$ROLLBACK/$i") || {
            rollback_verified=0
            continue
          }
          install -o root -g wheel -m "$mode" "$ROLLBACK/$i" "$destination" || rollback_verified=0
          expected=${state#present:}
          [[ -f "$destination" && ! -L "$destination" && "$(sha "$destination")" == "$expected" ]] || rollback_verified=0
          ;;
        absent)
          rm -f "$destination" || rollback_verified=0
          [[ ! -e "$destination" && ! -L "$destination" ]] || rollback_verified=0
          ;;
        *) rollback_verified=0 ;;
      esac
    done
    "$VISUDO" -c >/dev/null 2>&1 || rollback_verified=0
  fi
  if [[ $rollback_verified -ne 1 ]]; then
    printf 'CRITICAL: SecretSpec boundary rollback could not be verified; recovery: %s\n' "$ROLLBACK" >&2
    exit 125
  fi
  exit "$original_rc"
}
trap rollback EXIT

# Commit from protected staging only. Activate rollback before the first move.
commit_started=1
for i in "${!DESTINATIONS[@]}"; do
  destination=${DESTINATIONS[$i]}
  tmp="${destination}.new.$$"
  install -o root -g wheel -m "${MODES[$i]}" "$STAGE/$i" "$tmp"
  mv -f "$tmp" "$destination"
  [[ "$(sha "$destination")" == "$(sha "$STAGE/$i")" ]] || fail "installed hash mismatch: $destination"
done

# Never open, copy, or inspect runtime manifest/.env values.
if [[ -e "$VAULT/broker-audit.sqlite3" || -L "$VAULT/broker-audit.sqlite3" ]]; then
  [[ -f "$VAULT/broker-audit.sqlite3" && ! -L "$VAULT/broker-audit.sqlite3" ]] || fail 'unsafe audit ledger path'
  [[ "$(stat -f '%Su:%Sg:%OLp' "$VAULT/broker-audit.sqlite3")" == '_secretspec:staff:600' ]] || fail 'audit ledger metadata mismatch'
fi
"$VISUDO" -c >/dev/null
bash -n "$LIBEXEC/sudo-secretspec-broker"
/usr/bin/python3 -m py_compile "$LIBEXEC/sudo-secretspec-audit"
/usr/bin/python3 -m py_compile "$BINDIR/sudo-secretspec-drift-check" "$BINDIR/sudo-secretspec"

# Authenticate the retained recovery set without including runtime secret data.
(
  cd "$ROLLBACK"
  : >MANIFEST.sha256
  for saved in [0-9]* [0-9]*.state; do
    [[ -f "$saved" ]] || continue
    /usr/bin/shasum -a 256 "$saved" >>MANIFEST.sha256
  done
  chown root:wheel MANIFEST.sha256
  chmod 0600 MANIFEST.sha256
)
commit_started=0
trap - EXIT
rm -rf "$STAGE"
# Keep the five newest root-owned recovery sets; they contain configuration, not values.
find "$LIBEXEC" -maxdepth 1 -type d -name 'sudo-secretspec-rollback-*' -print0 |
  xargs -0 ls -1dt 2>/dev/null | tail -n +6 | xargs -I{} rm -rf -- "{}" 2>/dev/null || true
printf 'SecretSpec managed boundary installed; rollback copies: %s\n' "$ROLLBACK"
