#!/usr/bin/env python3
"""Single supported SecretSpec client for this managed control node.

This command intentionally has no manifest, provider, profile, or direct-mode
options. It delegates fixed lifecycle operations to the root-owned broker and
executes `run` targets as the invoking user with a structured JSON environment.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from typing import Optional, Sequence

WRAPPER = "/usr/local/libexec/sudo-secretspec-broker"
NAME_RE = re.compile(r"^[A-Z][A-Z0-9_]*$")


def client_family() -> str:
    """Return a fixed client family; never persist caller-controlled IDs."""
    markers = (
        ("HERMES_SESSION_ID", "hermes"),
        ("CLAUDE_SESSION_ID", "claude"),
        ("CODEX_THREAD_ID", "codex"),
        ("OPENCODE_SESSION_ID", "opencode"),
        ("CURSOR_SESSION_ID", "cursor"),
        ("AGY_SESSION_ID", "agy"),
    )
    return next((family for key, family in markers if os.environ.get(key)), "unknown")


def base(operation: str, reason: str, command_basename: str = "") -> list[str]:
    result = ["sudo", "-n", WRAPPER, operation, "--client", client_family(), "--reason", reason]
    if command_basename:
        result += ["--command-basename", command_basename]
    return result


def valid_name(value: str) -> str:
    if not NAME_RE.fullmatch(value):
        raise argparse.ArgumentTypeError("secret name must be uppercase ASCII")
    return value


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description=__doc__)
    p.epilog = "--reason VALUE may appear before or after the operation (but before run's -- separator)."
    sub = p.add_subparsers(dest="operation", required=True)
    add = sub.add_parser("add")

    add.add_argument("name", type=valid_name)
    for name in ("set", "delete", "get"):
        cmd = sub.add_parser(name)

        cmd.add_argument("name", type=valid_name)
    sub.add_parser("check")

    sub.add_parser("export")

    run = sub.add_parser("run")

    run.add_argument("command", nargs=argparse.REMAINDER)
    return p


def invoke(args: argparse.Namespace) -> int:
    reason = getattr(args, "reason", "") or os.environ.get("SECRETSPEC_REASON", "")
    if not reason:
        raise SystemExit("--reason is required (before or after the operation)")
    mapping = {
        "add": "source-add",
        "set": "source-set",
        "delete": "source-delete",
        "get": "source-get",
        "check": "source-check",
        "export": "source-export",
        "run": "source-export",
    }
    target = list(args.command) if args.operation == "run" else []
    if target and target[0] == "--":
        target.pop(0)
    command = base(mapping[args.operation], reason, os.path.basename(target[0]) if target else "")
    if hasattr(args, "name"):
        command += ["--name", args.name]

    if args.operation != "run":
        return subprocess.run(command).returncode

    if not target:
        raise SystemExit("run requires a command after --")
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode:
        sys.stderr.write(result.stderr)
        return result.returncode
    try:
        values = json.loads(result.stdout)
    except json.JSONDecodeError:
        raise SystemExit("managed broker returned invalid JSON")
    if not isinstance(values, dict) or any(not isinstance(k, str) or not isinstance(v, str) for k, v in values.items()):
        raise SystemExit("managed broker returned an invalid environment")
    env = os.environ.copy()
    for key in ("SECRETSPEC_FILE", "SECRETSPEC_PROVIDER", "SECRETSPEC_PROFILE", "SUDO_SECRETSPEC_DIRECT"):
        env.pop(key, None)
    env.update(values)
    os.execvpe(target[0], target, env)
    return 127


def main(argv: Optional[Sequence[str]] = None) -> int:
    raw = list(sys.argv[1:] if argv is None else argv)
    reason = ""
    normalized = []
    index = 0
    while index < len(raw):
        if raw[index] == "--":
            normalized.extend(raw[index:])
            break
        if raw[index] == "--reason":
            if index + 1 >= len(raw):
                raise SystemExit("--reason requires a value")
            reason = raw[index + 1]
            index += 2
            continue
        normalized.append(raw[index])
        index += 1
    args = parser().parse_args(normalized)
    args.reason = reason
    return invoke(args)


if __name__ == "__main__":
    raise SystemExit(main())
