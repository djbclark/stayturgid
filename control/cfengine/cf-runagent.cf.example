# Generic example of the cf-runagent policy stayturgid renders per site.
# The live artifact is generated by `just deploy-mac` from
# ansible/roles/control_node/templates/cf-runagent.cf.j2 into the runtime
# config home: ~/.config/stayturgid/cfengine/cf-runagent.cf (never tracked).
# Addresses below are §4.1 fixtures (docs/architecture/multi-site-topology.md).

body common control {
    bundlesequence => { "main" };
}

bundle agent main {
  reports:
      "cf-runagent policy loaded for stayturgid fleet control";
}

body runagent control {
    hosts => {
        "100.0.0.11:5308",
        "100.0.0.12:5308",
        "100.0.0.13:5308",
    };
    background_children => "true";
    max_children        => "5";
    timeout             => "30";
    trustkey            => "true";
    encrypt             => "true";
}
