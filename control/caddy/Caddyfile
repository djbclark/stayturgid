# Caddyfile — stayturgid HTTPS reverse proxy
# Deployed by: ansible/roles/control_node (caddy tasks)
# Config path: ~/.config/stayturgid/Caddyfile
#
# TLS: uses internal CA by default (no admin-console setup needed — valid
# on the Mac without browser warnings). To switch to publicly-trusted
# Let's Encrypt certs via Tailscale, enable "HTTPS Certificates" in the
# Tailscale admin console (DNS page), then change 'tls internal' below to
# 'tls { get_certificate tailscale }'.

{
    auto_https disable_redirects
    admin off
}

# Health check on separate HTTP port (launchd keepalive probe)
http://127.0.0.1:8080 {
    respond /health "OK" 200
}

# Main HTTPS entrypoint — all stayturgid services under one domain
https://djbclarks-macbook-air.tailf47663.ts.net {
    tls internal

    # Fleet dashboard
    handle_path /dashboard/* {
        reverse_proxy localhost:4097
    }

    # VLM server (llama.cpp UI-TARS)
    handle_path /vlm/* {
        reverse_proxy localhost:8081
    }

    # Default: OpenCode web UI
    handle {
        reverse_proxy localhost:4096
    }
}
