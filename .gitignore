# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Local tooling / CI scratch
.config.mk
.DS_Store
.venv-test/
.venv-gplaycli/
.ansible/collections/
.ansible/roles/
.ansible/modules/
.ansible/.lock

# Ansible collection test output (generated by ansible-test)
ansible_collections/stayturgid/*/tests/output/
ansible_collections/stayturgid/*/collections/

# Operator-local notes (human/ is tracked; responses are not)
human/RESPONSES.md

# Fleet a11y live snapshots (Mac CLI + android_a11y_services push temps)
control/lib/a11y_backups/*.txt
control/lib/a11y_backups/.*.tmp

# Local screenshot / audit dumps (gui-audit writes under ~/.config; keep repo clean)
artifacts/

# SSH keys — live on the control node / devices only, never in git
*.pem
id_*
termux_key
termux_key.pub
authorized_keys
known_hosts
