# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Local tooling / CI scratch / linter backups
.config.mk
.DS_Store
*.bak
.venv-test/
.venv-gplaycli/
.node_modules/
node_modules/
.ansible/collections/
.ansible/roles/
.ansible/modules/
.ansible/.lock

# Site inventory is private. CI creates this ignored file from the example.
ansible/inventory/hosts.yml

# Ansible collection test output (generated by ansible-test)
ansible_collections/stayturgid/*/tests/output/
ansible_collections/stayturgid/*/collections/

# Operator-local notes (human/ is tracked; responses are not)
human/RESPONSES.md

# Fleet a11y live snapshots (Mac CLI + android_a11y_services push temps)
control/lib/a11y_backups/*.txt
control/lib/a11y_backups/.*.tmp

# Local screenshot / audit dumps (gui-audit writes under ~/.config; keep repo clean)
artifacts/
tmp/

# CFEngine Build output (built locally before Ansible deploy; never source).
device/termux/cfengine/out/

# SSH keys / TLS key material — live on the control node / devices only, never in git
*.pem
*.key
*.crt
/root.crt
/root.key
id_*
termux_key
termux_key.pub
authorized_keys
known_hosts

# API keys / secrets (live under ~/.config/stayturgid/ — never commit)
*.env
!*.env.example
**/gemini.env
**/anthropic.env
**/vlm-cloud.env
**/play.env
secrets/
.secrets/
node_modules/
package-lock.json
/yarn.lock
/pnpm-lock.yaml
