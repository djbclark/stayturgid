---
extensions:
  file_storage:
    directory: "{{ stayturgid_otelcol_state_dir }}"
    create_directory: true
    fsync: {{ stayturgid_otelcol_storage_fsync | default("false") }}
    compaction:
      on_start: true
      directory: "{{ stayturgid_otelcol_state_dir }}/compaction"

receivers:
  file_log/repair:
    include:
      - "{{ termux_home }}/.stayturgid/logs/repair.jsonl"
    start_at: end
    # 200ms (the upstream default) is far too hot for a file that gains a
    # line every ~15 min — see stayturgid_otelcol_poll_interval in
    # roles/termux_userland/defaults/main.yml.
    poll_interval: {{ stayturgid_otelcol_poll_interval | default("30s") }}
    storage: file_storage
    include_file_name: false
    resource:
      service.name: stayturgid
      host.name: "{{ inventory_hostname }}"
      stayturgid.log.source: repair
    operators:
      - type: json_parser
        parse_from: body
        # drop (not drop_quiet): malformed lines are still dropped (never
        # forwarded), but the collector logs a warning to its own log
        # (~/.stayturgid/logs/otelcol.log) so parse-failure data loss isn't
        # silent (M1-Q S-10).
        on_error: drop
        timestamp:
          parse_from: attributes.timestamp
          layout_type: gotime
          layout: "2006-01-02T15:04:05.000Z"
        severity:
          parse_from: attributes.level
      - type: move
        from: attributes.message
        to: body
  file_log/watchdog:
    include:
      - "{{ stayturgid_sd_root }}/logs/watchdog.jsonl"
    start_at: end
    # 200ms (the upstream default) is far too hot for a file that gains a
    # line every ~15 min — see stayturgid_otelcol_poll_interval in
    # roles/termux_userland/defaults/main.yml.
    poll_interval: {{ stayturgid_otelcol_poll_interval | default("30s") }}
    storage: file_storage
    include_file_name: false
    resource:
      service.name: stayturgid
      host.name: "{{ inventory_hostname }}"
      stayturgid.log.source: watchdog
    operators:
      - type: json_parser
        parse_from: body
        # drop (not drop_quiet): malformed lines are still dropped (never
        # forwarded), but the collector logs a warning to its own log
        # (~/.stayturgid/logs/otelcol.log) so parse-failure data loss isn't
        # silent (M1-Q S-10).
        on_error: drop
        timestamp:
          parse_from: attributes.timestamp
          layout_type: gotime
          layout: "2006-01-02T15:04:05.000Z"
        severity:
          parse_from: attributes.level
      - type: move
        from: attributes.message
        to: body

processors:
  memory_limiter:
    check_interval: {{ stayturgid_otelcol_memory_check_interval | default("30s") }}
    limit_mib: 100
    spike_limit_mib: 20
  batch:
    timeout: 30s

exporters:
  otlp_http/vector:
    endpoint: "{{ stayturgid_otelcol_endpoint }}"
    timeout: 10s
    retry_on_failure:
      enabled: true
      initial_interval: 5s
      max_interval: 30s
      max_elapsed_time: 0s
    sending_queue:
      enabled: true
      storage: file_storage
      num_consumers: 1
      queue_size: 1000
      block_on_overflow: true

service:
  # No self-metrics listener: nothing scrapes it (fleet health checks the
  # pidfile), and its default localhost:8888 collides with apps on the phone
  # (AirSync holds *:8888 on t2e, so the collector exited at startup).
  telemetry:
    metrics:
      level: none
  extensions: [file_storage]
  pipelines:
    logs:
      receivers: [file_log/repair, file_log/watchdog]
      processors: [memory_limiter, batch]
      exporters: [otlp_http/vector]
