{# Build known_hosts entries: every alias for every peer in the mesh group. #}
{% set entries = [] %}
{% for peer in groups[stayturgid_ssh_mesh_group] %}
{%   if peer != inventory_hostname and hostvars[peer].stayturgid_sshd_host_pubkey is defined and hostvars[peer].stayturgid_sshd_host_pubkey | trim | length > 0 %}
{%     set aliases = hostvars[peer].stayturgid_ssh_known_host_aliases | default([hostvars[peer].inventory_hostname, hostvars[peer].ansible_host]) %}
{%     for alias in aliases %}
{%       if alias is defined and alias | string | trim | length > 0 %}
{%         set _ = entries.append({
              'name': '[' ~ alias ~ ']:' ~ (hostvars[peer].ansible_port | default(8022) | string),
              'key': hostvars[peer].stayturgid_sshd_host_pubkey | trim
            }) %}
{%       endif %}
{%     endfor %}
{%   endif %}
{% endfor %}
{{ entries | to_json }}
