#!/bin/sh
# Minimal GNU-style configure: report tool availability and write .config.mk.
# Nothing here is required — `make test` degrades gracefully — this just tells
# you up front what will run and what will be skipped.

out=.config.mk
: > "$out"

have() { command -v "$1" >/dev/null 2>&1; }
row() { printf '  %-16s %s\n' "$1" "$2"; }

echo "stayturgid configure"
echo ""
echo "required:"
if have bash; then row "bash" "$(bash -c 'echo $BASH_VERSION')"; else row "bash" "MISSING"; fail=1; fi
if have python3; then row "python3" "$(python3 -V 2>&1 | cut -d' ' -f2)"; else row "python3" "MISSING"; fail=1; fi
if have git; then row "git" "ok"; else row "git" "MISSING"; fail=1; fi

echo "optional (tests skip if missing):"
if have node; then row "node" "$(node -v)"; echo "HAVE_NODE := 1" >> "$out"; else row "node" "missing — JS unit tests skipped"; fi
if have ansible-playbook; then row "ansible" "$(ansible-playbook --version 2>/dev/null | head -1 | sed 's/.*core //;s/].*//')"; echo "HAVE_ANSIBLE := 1" >> "$out"; else row "ansible" "missing — ansible checks + module tests skipped"; fi
if have shellcheck; then row "shellcheck" "ok"; echo "HAVE_SHELLCHECK := 1" >> "$out"; else row "shellcheck" "missing — make lint partial (brew install shellcheck)"; fi
if have ansible-lint; then row "ansible-lint" "ok"; else row "ansible-lint" "missing — make lint partial"; fi
if have ssh; then row "ssh" "ok"; else row "ssh" "missing — device tier unavailable"; fi

echo ""
if [ "${fail:-0}" = 1 ]; then
    echo "configure: FAILED (missing required tools)"
    rm -f "$out"
    exit 1
fi
echo "wrote $out — next: make check | make test | make verify"
