---
# Copy to inventory/hosts.yml and edit.
stayturgid:
  hosts:
    oneui-device:
      ansible_host: 100.0.0.2
      ansible_port: 8022
      ansible_user: u0_a123
      ansible_python_interpreter: /data/data/com.termux/files/usr/bin/python
      termux_prefix: /data/data/com.termux/files/usr
      termux_home: /data/data/com.termux/files/home
      stayturgid_sd_root: /sdcard/stayturgid
      stayturgid_device_id: oneui-device
      device_usb_serial: R5CX12345678
  vars:
    # Neo / Aurora parked by default — match production fleet (see docs/modules/fdroid.md).
    stayturgid_app_stores_enabled: false
    stayturgid_ensure_neo_store: false
    stayturgid_ensure_aurora_store: false
    stayturgid_install_aurora_store: false
    stayturgid_ensure_apps: []
    # Example:
    # stayturgid_ensure_apps:
    #   - id: org.breezyweather
    #     source: fdroid
