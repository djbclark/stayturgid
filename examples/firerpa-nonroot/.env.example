# Copy to .env beside the justfile. just loads it automatically.
# ADB_TARGET may be a USB serial, emulator serial, or host:port.
ADB_TARGET=YOUR_ADB_SERIAL

# Network address used by SSH and gRPC clients. This can differ from ADB_TARGET.
FIRERPA_HOST=YOUR_DEVICE_IP_OR_DNS_NAME

# Defaults shown for clarity.
FIRERPA_PORT=65000
FIRERPA_ARCH=arm64-v8a
FIRERPA_ROOT=/data/local/tmp/firerpa
FIRERPA_PYTHON=python3.12

# Optional: reuse an existing private service certificate instead of certs/lamda.pem.
# FIRERPA_CERTIFICATE=/absolute/path/to/lamda.pem
