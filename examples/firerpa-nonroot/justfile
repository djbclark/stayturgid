# Standalone FIRERPA deployment for an unrooted Android device.
#
# Quick start:
#   cp .env.example .env
#   $EDITOR .env
#   just install
#   just ssh-id
#   just grpc
#
# `just --list` is the short operator guide. README.md explains every step,
# security implication, manual equivalent, and recovery path.

set dotenv-load
set shell := ["bash", "-uc"]

# Empty means the latest upstream release: `just fetch` resolves GitHub's
# releases/latest and records the answer in WORKDIR, and every later step
# (client, patch, venv) uses that recorded version. Set it to pin a release.
FIRERPA_VERSION := env_var_or_default("FIRERPA_VERSION", "")
FIRERPA_ARCH := env_var_or_default("FIRERPA_ARCH", "arm64-v8a")
FIRERPA_PORT := env_var_or_default("FIRERPA_PORT", "65000")
FIRERPA_ROOT := env_var_or_default("FIRERPA_ROOT", "/data/local/tmp/firerpa")

# The newest Python the lamda client installs on: lamda declares
# Requires-Python <3.15, and grpcio publishes no cp315 wheels. Raise this when
# both move.
FIRERPA_PYTHON := env_var_or_default("FIRERPA_PYTHON", "python3.14")
ADB_TARGET := env_var_or_default("ADB_TARGET", "")
FIRERPA_HOST := env_var_or_default("FIRERPA_HOST", "")
CONFIRM := env_var_or_default("CONFIRM", "NO")

BASE := justfile_directory()
WORKDIR := env_var_or_default("WORKDIR", BASE + "/.work")
CERT_DIR := env_var_or_default("CERT_DIR", BASE + "/certs")
VENV := WORKDIR + "/venv"
ARCHIVE_NAME := "lamda-server-" + FIRERPA_ARCH + ".tar.gz"
ARCHIVE := WORKDIR + "/" + ARCHIVE_NAME
CLIENT_ARCHIVE := WORKDIR + "/lamda-client-py.tar.gz"
VERSION_FILE := WORKDIR + "/firerpa-version"
PATCH_SCRIPT := WORKDIR + "/firerpa_service_patch.py"
LIFECYCLE_SCRIPT := WORKDIR + "/firerpa_lifecycle.py"
PATCHED_DRIVER := WORKDIR + "/aab.zip.patched"
DEFAULT_CERTIFICATE := CERT_DIR + "/lamda.pem"
CERTIFICATE := env_var_or_default("FIRERPA_CERTIFICATE", DEFAULT_CERTIFICATE)
DEVICE_CERTIFICATE := FIRERPA_ROOT + "/server/lamda.pem"

# Everything tracks a moving target by default: the latest FIRERPA release,
# upstream's default branch for tools/cert.py, and stayturgid master for the two
# helper scripts. README.md "Pinning for reproducibility" shows how to fix each.
UPSTREAM_SOURCE_REF := env_var_or_default("UPSTREAM_SOURCE_REF", "HEAD")
STAYTURGID_REF := env_var_or_default("STAYTURGID_REF", "master")
STAYTURGID_RAW := "https://raw.githubusercontent.com/djbclark/stayturgid/" + STAYTURGID_REF

# Optional SHA-256 pins. Empty server/client pins fall back to the checksum the
# release publishes (PyPI's digest for the client, which ships no .sha256sum);
# empty helper pins download whatever the ref holds and print its digest.
SERVER_SHA256 := env_var_or_default("SERVER_SHA256", "")
CLIENT_SHA256 := env_var_or_default("CLIENT_SHA256", "")
CERT_TOOL_SHA256 := env_var_or_default("CERT_TOOL_SHA256", "")
PATCH_SCRIPT_SHA256 := env_var_or_default("PATCH_SCRIPT_SHA256", "")
LIFECYCLE_SCRIPT_SHA256 := env_var_or_default("LIFECYCLE_SCRIPT_SHA256", "")

# Show available operations.
default:
    @just --justfile "{{ BASE }}/justfile" --list

# Show the effective non-secret configuration.
config:
    #!/usr/bin/env bash
    set -euo pipefail
    version="{{ FIRERPA_VERSION }}"
    if test -z "$version"; then
      version="latest"
      test ! -f "{{ VERSION_FILE }}" || version="latest (last fetched: $(cat "{{ VERSION_FILE }}"))"
    fi
    printf '%s\n' \
      "ADB_TARGET={{ ADB_TARGET }}" \
      "FIRERPA_HOST={{ FIRERPA_HOST }}" \
      "FIRERPA_VERSION=$version" \
      "FIRERPA_ARCH={{ FIRERPA_ARCH }}" \
      "FIRERPA_PORT={{ FIRERPA_PORT }}" \
      "FIRERPA_ROOT={{ FIRERPA_ROOT }}" \
      "FIRERPA_PYTHON={{ FIRERPA_PYTHON }}" \
      "STAYTURGID_REF={{ STAYTURGID_REF }}" \
      "UPSTREAM_SOURCE_REF={{ UPSTREAM_SOURCE_REF }}" \
      "WORKDIR={{ WORKDIR }}" \
      "CERTIFICATE={{ CERTIFICATE }}"

# Verify host tools, ADB reachability, architecture, and Android shell UID.
doctor: _require-adb-target
    #!/usr/bin/env bash
    set -euo pipefail
    for tool in adb curl ssh uv; do
      command -v "$tool" >/dev/null || { echo "ERROR: missing host tool: $tool" >&2; exit 1; }
    done
    command -v "{{ FIRERPA_PYTHON }}" >/dev/null || {
      echo "ERROR: missing {{ FIRERPA_PYTHON }}; install it or set FIRERPA_PYTHON to the newest Python the lamda client supports" >&2
      exit 1
    }
    case "{{ FIRERPA_ARCH }}" in
      arm64-v8a|armeabi-v7a|x86|x86_64) ;;
      *) echo "ERROR: unsupported FIRERPA_ARCH={{ FIRERPA_ARCH }}" >&2; exit 1 ;;
    esac
    case "{{ FIRERPA_ROOT }}" in
      /*) ;;
      *) echo "ERROR: FIRERPA_ROOT must be an absolute Android path" >&2; exit 1 ;;
    esac
    adb -s "{{ ADB_TARGET }}" get-state | grep -qx device
    uid="$(adb -s "{{ ADB_TARGET }}" shell id -u | tr -d '\r')"
    test "$uid" = 2000 || {
      echo "ERROR: adb shell UID is $uid; this guide expects Android shell UID 2000" >&2
      exit 1
    }
    abi="$(adb -s "{{ ADB_TARGET }}" shell getprop ro.product.cpu.abi | tr -d '\r')"
    test "$abi" = "{{ FIRERPA_ARCH }}" || {
      echo "ERROR: device ABI is $abi but FIRERPA_ARCH={{ FIRERPA_ARCH }}" >&2
      exit 1
    }
    echo "OK: {{ ADB_TARGET }} is reachable as shell UID 2000 ($abi)"

# Resolve the release, download its server/client artifacts and the setup helpers; verify SHA-256.
fetch:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{ WORKDIR }}"
    py="{{ FIRERPA_PYTHON }}"
    fetch() { curl --fail --location --retry 3 --silent --show-error --output "$2" "$1"; }
    digest() { "$py" -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],"rb").read()).hexdigest())' "$1"; }
    require_sha256() {
      [[ "$2" =~ ^[0-9a-f]{64}$ ]] || { echo "ERROR: $1 has no usable SHA-256 (got '$2')" >&2; exit 1; }
    }
    # fetch_verified URL DEST SHA256: reuse DEST when it already has those bytes.
    fetch_verified() {
      require_sha256 "$2" "$3"
      if test ! -f "$2" || test "$(digest "$2")" != "$3"; then
        fetch "$1" "$2"
      fi
      actual="$(digest "$2")"
      test "$actual" = "$3" || {
        echo "ERROR: SHA-256 mismatch for $2: $actual (expected $3)" >&2
        exit 1
      }
    }
    # fetch_source URL DEST [SHA256]: source helpers follow a moving ref, so they
    # are re-downloaded each time and verified only when a pin is set.
    fetch_source() {
      if test -n "$3"; then
        fetch_verified "$1" "$2" "$3"
      else
        fetch "$1" "$2"
        echo "unpinned: $(digest "$2")  $2"
      fi
    }
    published_sha256() { awk 'NR == 1 {print $1}' "$1"; }

    version="{{ FIRERPA_VERSION }}"
    if test -z "$version"; then
      # github.com/<repo>/releases/latest redirects to the newest non-draft,
      # non-prerelease tag; unlike the REST API it is not rate limited.
      latest="$(curl --fail --location --retry 3 --silent --show-error --output /dev/null \
        --write-out '%{url_effective}' https://github.com/firerpa/lamda/releases/latest)"
      version="${latest##*/tag/}"
      version="${version#v}"
    fi
    [[ "$version" =~ ^[0-9]+(\.[0-9]+)+$ ]] || { echo "ERROR: FIRERPA version '$version' is not a dotted version" >&2; exit 1; }
    release="https://github.com/firerpa/lamda/releases/download/v$version"
    echo "FIRERPA $version"

    server_sha256="{{ SERVER_SHA256 }}"
    if test -z "$server_sha256"; then
      fetch "$release/{{ ARCHIVE_NAME }}.sha256sum" "{{ ARCHIVE }}.sha256sum"
      server_sha256="$(published_sha256 "{{ ARCHIVE }}.sha256sum")"
    fi
    fetch_verified "$release/{{ ARCHIVE_NAME }}" "{{ ARCHIVE }}" "$server_sha256"

    client_name="lamda-client-py-$version.tar.gz"
    client_sha256="{{ CLIENT_SHA256 }}"
    if test -z "$client_sha256" && fetch "$release/$client_name.sha256sum" "{{ CLIENT_ARCHIVE }}.sha256sum" 2>/dev/null; then
      client_sha256="$(published_sha256 "{{ CLIENT_ARCHIVE }}.sha256sum")"
    fi
    if test -z "$client_sha256"; then
      # The release publishes no client checksum, but PyPI serves the same sdist
      # bytes as lamda-<version>.tar.gz and publishes their SHA-256.
      client_sha256="$(curl --fail --location --retry 3 --silent --show-error "https://pypi.org/pypi/lamda/$version/json" |
        "$py" -c 'import json,sys; name=f"lamda-{sys.argv[1]}.tar.gz"; print(next((u["digests"]["sha256"] for u in json.load(sys.stdin)["urls"] if u["filename"] == name), ""))' "$version")"
    fi
    fetch_verified "$release/$client_name" "{{ CLIENT_ARCHIVE }}" "$client_sha256"

    fetch_source "https://raw.githubusercontent.com/firerpa/lamda/{{ UPSTREAM_SOURCE_REF }}/tools/cert.py" "{{ WORKDIR }}/cert.py" "{{ CERT_TOOL_SHA256 }}"
    fetch_source "{{ STAYTURGID_RAW }}/ansible_collections/stayturgid/firerpa/roles/firerpa/files/firerpa_service_patch.py" "{{ PATCH_SCRIPT }}" "{{ PATCH_SCRIPT_SHA256 }}"
    fetch_source "{{ STAYTURGID_RAW }}/ansible_collections/stayturgid/firerpa/roles/firerpa/files/firerpa_lifecycle.py" "{{ LIFECYCLE_SCRIPT }}" "{{ LIFECYCLE_SCRIPT_SHA256 }}"
    chmod 0755 "{{ PATCH_SCRIPT }}" "{{ LIFECYCLE_SCRIPT }}"
    printf '%s\n' "$version" > "{{ VERSION_FILE }}"
    echo "OK: FIRERPA $version artifacts verified; helpers from stayturgid {{ STAYTURGID_REF }}"

# Create an isolated Python environment with cert generation and gRPC client support.
venv: fetch
    #!/usr/bin/env bash
    set -euo pipefail
    stamp="{{ VENV }}/.firerpa-$(cat "{{ VERSION_FILE }}")-{{ FIRERPA_PYTHON }}"
    if test -x "{{ VENV }}/bin/python" && test -f "$stamp" && \
       "{{ VENV }}/bin/python" -c 'import cryptography; from lamda.client import Device'; then
      echo "OK: preserving ready Python environment at {{ VENV }}"
      exit 0
    fi
    rm -rf "{{ VENV }}"
    uv venv --python "{{ FIRERPA_PYTHON }}" "{{ VENV }}"
    # Fail instead of compiling grpcio from source (a long C++ build) when this
    # Python has no wheel for it; lower FIRERPA_PYTHON instead.
    uv pip install --python "{{ VENV }}/bin/python" --quiet --only-binary grpcio,grpcio-tools cryptography "{{ CLIENT_ARCHIVE }}"
    touch "$stamp"
    echo "OK: Python environment ready at {{ VENV }}"

# Generate certs/lamda.pem once; it is the TLS credential and SSH private identity.
certificate: venv
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{ CERT_DIR }}"
    chmod 0700 "{{ CERT_DIR }}"
    if test -f "{{ CERTIFICATE }}"; then
      echo "OK: preserving existing {{ CERTIFICATE }}"
      exit 0
    fi
    test "{{ CERTIFICATE }}" = "{{ DEFAULT_CERTIFICATE }}" || {
      echo "ERROR: FIRERPA_CERTIFICATE does not exist: {{ CERTIFICATE }}" >&2
      exit 1
    }
    cp "{{ WORKDIR }}/cert.py" "{{ CERT_DIR }}/cert.py"
    (cd "{{ CERT_DIR }}" && PYTHONWARNINGS=ignore::DeprecationWarning "{{ VENV }}/bin/python" cert.py lamda)
    chmod 0600 "{{ CERTIFICATE }}" "{{ CERT_DIR }}/root.key"
    echo "OK: generated {{ CERTIFICATE }}; back it up securely and never commit it"

# Build the patched aab.zip; the patcher refuses an unaudited release before the device is touched.
patch: fetch
    #!/usr/bin/env bash
    set -euo pipefail
    "{{ FIRERPA_PYTHON }}" "{{ PATCH_SCRIPT }}" --version "$(cat "{{ VERSION_FILE }}")" \
      --archive "{{ ARCHIVE }}" --output "{{ PATCHED_DRIVER }}"
    echo "OK: accessibility-coexistence driver ready at {{ PATCHED_DRIVER }}"

# Prepare all host-side artifacts without changing the Android device.
prepare: venv certificate patch
    @echo "OK: host-side FIRERPA materials are ready"

# Install the server, certificate, signed/patched drivers, properties, and lifecycle helper.
deploy: doctor prepare
    #!/usr/bin/env bash
    set -euo pipefail
    adb=(adb -s "{{ ADB_TARGET }}")
    root="{{ FIRERPA_ROOT }}"
    remote_archive=/data/local/tmp/firerpa-server.tar.gz
    active="$root/server/lib/python3.*/site-packages/lamda/aab.zip"

    "${adb[@]}" push "{{ ARCHIVE }}" "$remote_archive"
    "${adb[@]}" shell '
      pkill -9 -x lamda 2>/dev/null || true
      for proc in /proc/[0-9]*; do
        exe=$(readlink "$proc/exe" 2>/dev/null) || continue
        case "$exe" in
          '"$root"'/server/*) kill -9 "${proc##*/}" 2>/dev/null || true ;;
        esac
      done
      rm -rf '"$root"'/server /data/local/tmp/usr
      mkdir -p '"$root"'
      tar xzf '"$remote_archive"' -C '"$root"'
      mkdir -p '"$root"'/overrides
      cp '"$active"' '"$root"'/overrides/aab.zip.signed
      chmod 0644 '"$root"'/overrides/aab.zip.signed
    '
    "${adb[@]}" push "{{ PATCHED_DRIVER }}" "$root/overrides/aab.zip.patched"
    "${adb[@]}" push "{{ LIFECYCLE_SCRIPT }}" "$root/firerpa_lifecycle.py"
    "${adb[@]}" push "{{ CERTIFICATE }}" "{{ DEVICE_CERTIFICATE }}"

    properties="{{ WORKDIR }}/properties.local"
    printf '%s\n' \
      'port={{ FIRERPA_PORT }}' \
      '[sshd]' 'sshd.enable=true' \
      '[adb]' 'adb.enable=false' \
      '[cron]' 'cron.enable=false' \
      '[fwd]' 'fwd.enable=false' \
      '[tunnel2]' 'tunnel2.enable=false' \
      '[mdns]' 'mdns.enable=false' \
      '[webui]' 'webui.darkmode=off' 'webui.audio=off' 'webui.webrtc=off' \
      'webui.video.h264=off' 'webui.share-clipboard=off' > "$properties"
    "${adb[@]}" push "$properties" "$root/server/properties.local"
    "${adb[@]}" shell "chmod 0600 '{{ DEVICE_CERTIFICATE }}'; chmod 0644 '$root/overrides/aab.zip.patched' '$root/server/properties.local'; chmod 0755 '$root/firerpa_lifecycle.py'"
    echo "OK: FIRERPA deployed but not yet started"

# Start idempotently via the signed-start/patched-swap lifecycle controller.
start: doctor prepare
    "{{ VENV }}/bin/python" "{{ LIFECYCLE_SCRIPT }}" start \
      --adb-target "{{ ADB_TARGET }}" \
      --root "{{ FIRERPA_ROOT }}" \
      --port "{{ FIRERPA_PORT }}" \
      --certificate "{{ DEVICE_CERTIFICATE }}"

# Deploy, start, and show device-side status.
install: deploy start status
    @echo "OK: standalone FIRERPA installation complete"

# Show listener, process ownership, active driver hash, and expected patched hash.
status: _require-adb-target
    #!/usr/bin/env bash
    set -euo pipefail
    test -f "{{ PATCHED_DRIVER }}" || { echo "ERROR: {{ PATCHED_DRIVER }} is missing; run just patch first" >&2; exit 1; }
    expected="$("{{ FIRERPA_PYTHON }}" -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],"rb").read()).hexdigest())' "{{ PATCHED_DRIVER }}")"
    adb -s "{{ ADB_TARGET }}" shell '
      echo "uid=$(id -u)"
      echo "listener:"
      ss -ltn 2>/dev/null | grep ":{{ FIRERPA_PORT }} " || {
        echo "ERROR: FIRERPA is not listening on {{ FIRERPA_PORT }}" >&2
        exit 1
      }
      echo "lamda processes:"
      ps -A -o USER,PID,NAME,ARGS 2>/dev/null | grep "[l]amda" || true
      echo "active aab.zip:"
      line=$(sha256sum {{ FIRERPA_ROOT }}/server/lib/python3.*/site-packages/lamda/aab.zip)
      echo "$line"
      test "${line%% *}" = '"$expected"' || {
        echo "ERROR: active aab.zip is not the expected accessibility patch" >&2
        exit 1
      }
      echo "OK: listener and accessibility-coexistence driver are active"
    '

# Open interactive FIRERPA SSH as Android's non-root shell user.
ssh: _require-host certificate
    ssh -o IdentitiesOnly=yes -i "{{ CERTIFICATE }}" -p "{{ FIRERPA_PORT }}" "shell@{{ FIRERPA_HOST }}"

# Prove SSH authentication and print Android UID (must be 2000).
ssh-id: _require-host certificate
    ssh -o BatchMode=yes -o IdentitiesOnly=yes -i "{{ CERTIFICATE }}" -p "{{ FIRERPA_PORT }}" "shell@{{ FIRERPA_HOST }}" id

# Prove certificate-authenticated gRPC and print FIRERPA version/uptime.
grpc: _require-host venv certificate
    "{{ VENV }}/bin/python" -c 'from lamda.client import Device; import sys; d=Device(sys.argv[1], port=int(sys.argv[2]), certificate=sys.argv[3]); i=d.server_info(); print(f"FIRERPA v{i.version} uptime={i.uptime}s")' "{{ FIRERPA_HOST }}" "{{ FIRERPA_PORT }}" "{{ CERTIFICATE }}"

# Stop FIRERPA and its embedded helper processes without removing files.
stop: _require-adb-target
    #!/usr/bin/env bash
    set -euo pipefail
    adb -s "{{ ADB_TARGET }}" shell '
      pkill -9 -x lamda 2>/dev/null || true
      for proc in /proc/[0-9]*; do
        exe=$(readlink "$proc/exe" 2>/dev/null) || continue
        case "$exe" in
          {{ FIRERPA_ROOT }}/server/*) kill -9 "${proc##*/}" 2>/dev/null || true ;;
        esac
      done
    '
    @echo "OK: FIRERPA stopped"

# Remove the device installation. Requires: just CONFIRM=YES uninstall
uninstall: _require-adb-target
    #!/usr/bin/env bash
    set -euo pipefail
    test "{{ CONFIRM }}" = YES || {
      echo "Refusing destructive uninstall. Run: just CONFIRM=YES uninstall" >&2
      exit 2
    }
    adb -s "{{ ADB_TARGET }}" shell '
      pkill -9 -x lamda 2>/dev/null || true
      for proc in /proc/[0-9]*; do
        exe=$(readlink "$proc/exe" 2>/dev/null) || continue
        case "$exe" in
          {{ FIRERPA_ROOT }}/server/*) kill -9 "${proc##*/}" 2>/dev/null || true ;;
        esac
      done
    '
    adb -s "{{ ADB_TARGET }}" shell rm -rf "{{ FIRERPA_ROOT }}" /data/local/tmp/firerpa-server.tar.gz /data/local/tmp/usr
    echo "OK: device installation removed; host certificate was preserved"

# Delete downloaded/build artifacts but preserve certs/ and its private keys.
clean:
    rm -rf "{{ WORKDIR }}"
    @echo "OK: removed {{ WORKDIR }}; preserved {{ CERT_DIR }}"

[private]
_require-adb-target:
    @test -n "{{ ADB_TARGET }}" || { echo "ERROR: set ADB_TARGET in .env or on the command line" >&2; exit 2; }

[private]
_require-host:
    @test -n "{{ FIRERPA_HOST }}" || { echo "ERROR: set FIRERPA_HOST in .env or on the command line" >&2; exit 2; }
