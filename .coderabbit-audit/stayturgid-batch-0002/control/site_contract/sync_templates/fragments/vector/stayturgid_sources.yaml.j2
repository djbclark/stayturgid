# GENERATED by stayturgid site-sync — DO NOT EDIT (drift → site-sync exit 2)
# template: control/site_contract/sync_templates/fragments/vector/stayturgid_sources.yaml.j2
# product_version: {{ product_version }}
#
# Product Vector sources. Component ids are stayturgid_*-prefixed (§5.3).
# Ports come only from the site registry (StrictUndefined → exit 1 if missing).
# Own-mode unit passes extra --config args pointing at this file (no copy step).
#
# soft_health: crash-safe file tail. Writers append whole JSON lines + fsync
# (~/.config/stayturgid/stats/soft_health.jsonl). Vector checkpoints offsets in
# data_dir; sink uses disk buffer + e2e acks so OpenObserve can be down for days.

sources:
  stayturgid_otlp_source:
    type: "opentelemetry"
    grpc:
      address: "127.0.0.1:{{ ports['vector-otlp-grpc'] }}"
    http:
      address: "0.0.0.0:{{ ports['vector-otlp-http'] }}"

  # Dual-run / Phase 3.5 soft-health samples (fleet_health_monitor → JSONL).
  # HOME is set in the Vector launchd plist; path must exist (touch empty OK).
  stayturgid_soft_health_file:
    type: "file"
    include:
      - "${HOME}/.config/stayturgid/stats/soft_health.jsonl"
    read_from: "beginning"
    ignore_not_found: true
    ignore_checkpoints: false
    oldest_first: true
    max_line_bytes: 65536
    fingerprint:
      strategy: "device_and_inode"

transforms:
  # Drop corrupt/partial lines; promote JSON fields for OpenObserve SQL.
  stayturgid_soft_health_parse:
    type: "remap"
    inputs: ["stayturgid_soft_health_file"]
    drop_on_error: true
    drop_on_abort: true
    source: |-
      raw, err = to_string(.message)
      if err != null {
        abort
      }
      raw = strip_whitespace(raw)
      if raw == "" {
        abort
      }
      parsed, err = parse_json(raw)
      if err != null {
        # Partial line after crash mid-write, or garbage — skip and continue.
        abort
      }
      if !is_object(parsed) {
        abort
      }
      . = parsed
      # Prefer event ts; fall back to ingest time so OO always has a timestamp.
      if exists(.ts) && is_string(.ts) {
        ts_parsed, err = parse_timestamp(.ts, format: "%+")
        if err == null {
          .timestamp = ts_parsed
        } else {
          ts_parsed2, err2 = parse_timestamp(.ts, format: "%Y-%m-%dT%H:%M:%SZ")
          if err2 == null {
            .timestamp = ts_parsed2
          } else {
            .timestamp = now()
          }
        }
      } else {
        .timestamp = now()
      }
      .service = "stayturgid-soft-health"
      .stream_name = "soft_health"
