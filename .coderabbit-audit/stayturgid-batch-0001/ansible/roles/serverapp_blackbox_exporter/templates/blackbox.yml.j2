# GENERATED by stayturgid site-sync — DO NOT EDIT (drift → site-sync exit 2)
# template: ansible/roles/serverapp_blackbox_exporter/templates/blackbox.yml.j2
# product_version: {{ product_version }}
#
# blackbox_exporter's own module definitions. Target lists live in
# VictoriaMetrics' scrape config (serverapp_victoriametrics), not here —
# this file only defines *how* to probe each protocol.

modules:
  http_2xx:
    prober: http
    timeout: 5s
    http:
      valid_http_versions: ["HTTP/1.1", "HTTP/2.0"]
      method: GET
      tls_config:
        insecure_skip_verify: {{ serverapp_blackbox_exporter_http_tls_insecure_skip_verify | bool | lower }}

  tcp_connect:
    prober: tcp
    timeout: 5s

  # Same technique Nagios's own check_ssh uses: connect + regex-match the
  # SSH-2.0 banner. No cryptographic negotiation, matching parity with
  # check_ssh's actual behavior (see plan doc / second-opinion review).
  ssh_banner:
    prober: tcp
    timeout: 5s
    tcp:
      query_response:
        - expect: "^SSH-2\\.0-"

  # Scripted EHLO/STARTTLS/EHLO handshake — the pattern in blackbox_exporter's
  # own upstream example config for SMTP.
  smtp_starttls:
    prober: tcp
    timeout: 10s
    tcp:
      query_response:
        - expect: "^220"
        - send: "EHLO prober"
        - expect: "^250-"
        - send: "STARTTLS"
        - expect: "^220"
        - starttls: true
        - send: "EHLO prober"
        - expect: "^250-"

  # Best-effort — verified per-deploy by the role's ICMP probe task. macOS
  # unprivileged ICMP via Go's x/net/icmp datagram-socket path is not
  # guaranteed under every launchd gui/<uid> context.
  icmp:
    prober: icmp
    timeout: 5s
    icmp:
      preferred_ip_protocol: "ip4"

  dns_udp:
    prober: dns
    timeout: 5s
    dns:
      query_name: "example.com."
      query_type: "A"
      transport_protocol: "udp"
