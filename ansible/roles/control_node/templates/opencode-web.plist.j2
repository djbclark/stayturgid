<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stayturgid.opencode-web</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{ stayturgid_opencode_path }}</string>
        <string>web</string>
        <string>--hostname</string>
        <string>0.0.0.0</string>
        <string>--port</string>
        <string>{{ stayturgid_opencode_web_port | string }}</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{ stayturgid_homebrew_prefix }}/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>WorkingDirectory</key>
    <string>{{ lookup('env', 'HOME') }}</string>
    <key>StandardOutPath</key>
    <string>{{ conf_dir }}/logs/opencode-web.log</string>
    <key>StandardErrorPath</key>
    <string>{{ conf_dir }}/logs/opencode-web.error.log</string>
</dict>
</plist>
