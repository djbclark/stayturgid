# Generated by ansible/roles/control_node (agents) — do not hand-edit.
# Fleet SSH aliases (Tailscale + LAN). Every device block is pinned to the
# passphrase-less fleet key (stayturgid_ssh_identity_files, termux_key only)
# with IdentityAgent none + IdentitiesOnly yes: a deploy must never reach the
# 1Password agent, whose Touch ID prompt guards keys such as vps-primary's.
# Each block also matches the device's ansible_host address, because Ansible
# and rsync connect to that bare IP, not the alias. An IP that matches no
# block falls through to a global `Host *` IdentityAgent (1Password) and pops
# the prompt (t2e, 2026-10-17).
# Host certificates signed by the stayturgid CA eliminate host-key warnings.
{% for h in groups['stayturgid'] %}
Host {{ h }} {{ hostvars[h].ansible_host }}
  HostName {{ hostvars[h].ansible_host }}
  Port {{ hostvars[h].ansible_port | default(8022) }}
  User {{ hostvars[h].ansible_user | default(inventory_hostname) }}
  IdentityAgent none
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
  UserKnownHostsFile ~/.ssh/known_hosts
{%   for key in stayturgid_ssh_identity_files %}
  IdentityFile {{ key }}
{%   endfor %}
{%   set lan_ip = ((stayturgid_live_lan_ips | default({})).get(h) or {}).get('ip') or hostvars[h].device_lan_ip | default('') %}
{%   if lan_ip | length > 0 and lan_ip != '-' %}
Host {{ h }}-lan
  # Live DHCP address (control/lib/lan_ips.py); fleet-health rewrites it when
  # it changes. HostKeyAlias makes the CA host cert (principal: {{ h }}) valid
  # whatever the current IP is.
  HostName {{ lan_ip }}
  HostKeyAlias {{ h }}
  Port {{ hostvars[h].ansible_port | default(8022) }}
  User {{ hostvars[h].ansible_user | default(inventory_hostname) }}
  IdentityAgent none
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
  UserKnownHostsFile ~/.ssh/known_hosts
{%     for key in stayturgid_ssh_identity_files %}
  IdentityFile {{ key }}
{%     endfor %}
{%   endif %}
Host {{ h }}-firerpa
  HostName {{ hostvars[h].ansible_host }}
  Port 65000
  User shell
  IdentityAgent none
  IdentitiesOnly yes
  IdentityFile {{ stayturgid_firerpa_certificate_path }}
  LogLevel ERROR
  # The server host key is regenerated when FIRERPA state is reinstalled.
  # Tailscale authenticates the node; the service certificate authenticates us.
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
{% endfor %}
