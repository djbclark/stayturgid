# GENERATED by stayturgid site-sync — DO NOT EDIT (drift → site-sync exit 2)
# template: ansible/roles/serverapp_caddy/templates/Caddyfile.j2
# product_version: own-mode site_ns={{ site_ns }}
#
# Own-mode base config: global options, health probe, site TLS blocks, and
# import of product fragments from the committed generated area (no copy step).
{
	auto_https disable_redirects
	admin off
}

# Health check on separate HTTP port (launchd keepalive probe)
http://127.0.0.1:{{ serverapp_caddy_health_port }} {
	respond /health "OK" 200
}

{% if serverapp_caddy_public_hostname | length > 0 %}
# ── HTTP → HTTPS redirect for public hostname ──────────────────────────────
http://{{ serverapp_caddy_public_hostname }} {
	redir https://{{ serverapp_caddy_public_hostname }}{uri} 301
}

# ── Main HTTPS entrypoint — product routes via fragment import ─────────────
{{ serverapp_caddy_public_hostname }} {
	tls {
		get_certificate tailscale
	}

	import {{ serverapp_caddy_fragment_glob }}
}

{% if serverapp_caddy_short_hostname | length > 0 %}
# Also serve on short MagicDNS name
{{ serverapp_caddy_short_hostname }} {
	tls {
		get_certificate tailscale
	}
	redir https://{{ serverapp_caddy_public_hostname }}{uri} 301
}
{% endif %}
{% else %}
# No serverapp_caddy_public_hostname set — import fragments at top level only.
# Fragments that need a site block must be full site blocks, or set the hostname.
import {{ serverapp_caddy_fragment_glob }}
{% endif %}
