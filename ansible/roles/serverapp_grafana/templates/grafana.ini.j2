# GENERATED by stayturgid site-sync — DO NOT EDIT (drift → site-sync exit 2)
# template: ansible/roles/serverapp_grafana/templates/grafana.ini.j2
# product_version: {{ product_version }}
#
# Own-mode Grafana base config. Datasources + dashboards provisioned from
# generated/stayturgid/fragments/grafana/ (ports from registry via site-sync).

[paths]
data = {{ serverapp_grafana_data_dir }}
logs = {{ serverapp_grafana_logs_dir }}
plugins = {{ serverapp_grafana_plugins_dir }}
provisioning = {{ serverapp_grafana_provisioning_dir }}

[server]
http_addr = {{ serverapp_grafana_http_addr }}
http_port = {{ serverapp_grafana_http_port }}
domain = {{ serverapp_grafana_domain }}
root_url = {{ serverapp_grafana_root_url }}
serve_from_sub_path = {{ serverapp_grafana_serve_from_sub_path | bool | lower }}
enable_gzip = true

[security]
# Local loopback only; admin still required for UI. No secrets in this file.
admin_user = admin
# Default brew password; operator should change on first login if exposed.
admin_password = admin
disable_gravatar = true

[users]
allow_sign_up = false
default_theme = dark

[auth.anonymous]
enabled = false

[analytics]
reporting_enabled = false
check_for_updates = false

[log]
mode = console file
level = info
